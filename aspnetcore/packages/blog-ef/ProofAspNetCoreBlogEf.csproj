<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Exe</OutputType>
    <AssemblyName>ProofAspNetCoreBlogEf</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <TsonicCsharpRuntimeProject Condition="'$(TsonicCsharpRuntimeProject)' == ''">$(MSBuildThisFileDirectory)runtime/Tsonic.CSharp.Runtime.csproj</TsonicCsharpRuntimeProject>
    <TsonicCsharpJsProject Condition="'$(TsonicCsharpJsProject)' == ''">$(MSBuildThisFileDirectory)runtime/Tsonic.CSharp.Js.csproj</TsonicCsharpJsProject>
    <TsonicProviderReferenceDirectory>$(MSBuildThisFileDirectory).tests/provider-references</TsonicProviderReferenceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="out/csharp/**/*.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <ProjectReference Include="$(TsonicCsharpRuntimeProject)" />
    <ProjectReference Include="$(TsonicCsharpJsProject)" />
  </ItemGroup>
  <Target Name="ValidateTsonicRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TsonicCsharpRuntimeProject)')" Text="Tsonic.CSharp.Runtime source project was not found at '$(TsonicCsharpRuntimeProject)'." />
    <Error Condition="!Exists('$(TsonicCsharpJsProject)')" Text="Tsonic.CSharp.Js source project was not found at '$(TsonicCsharpJsProject)'." />
  </Target>
  <Target Name="PrepareTsonicProviderReferences" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TsonicProviderReference
        Include="@(ReferencePath)"
        Condition="
          '%(ReferencePath.Extension)' == '.dll' and
          '%(ReferencePath.NuGetPackageId)' != '' and
          '%(ReferencePath.FrameworkReferenceName)' == ''
        "
      />
    </ItemGroup>
    <RemoveDir Directories="$(TsonicProviderReferenceDirectory)" />
    <MakeDir Directories="$(TsonicProviderReferenceDirectory)" />
    <Copy SourceFiles="@(TsonicProviderReference)" DestinationFolder="$(TsonicProviderReferenceDirectory)" />
  </Target>
</Project>
