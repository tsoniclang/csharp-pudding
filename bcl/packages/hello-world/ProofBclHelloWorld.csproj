<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>Exe</OutputType>
    <AssemblyName>ProofBclHelloWorld</AssemblyName>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TsonicCsharpRuntimeProject Condition="'$(TsonicCsharpRuntimeProject)' == ''">$(MSBuildThisFileDirectory)runtime/Tsonic.CSharp.Runtime.csproj</TsonicCsharpRuntimeProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="out/csharp/**/*.cs" />
    <ProjectReference Include="$(TsonicCsharpRuntimeProject)" />
  </ItemGroup>
  <Target Name="ValidateTsonicRuntime" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(TsonicCsharpRuntimeProject)')" Text="Tsonic.CSharp.Runtime source project was not found at '$(TsonicCsharpRuntimeProject)'." />
  </Target>
</Project>
